# Server-side targets for the Vite development/preview proxy.
SIMULATOR_MAITRI_TARGET=http://127.0.0.1:8081
SIMULATOR_BHARATI_TARGET=http://127.0.0.1:8082
PATCH_SERVICE_TARGET=http://127.0.0.1:18080
# Browser simulation is the default and needs no backend on Vercel.
# Set this to live only when running the local services below.
VITE_DATA_MODE=demo
